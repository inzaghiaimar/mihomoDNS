# clash-mosdns 一键安装项目 — 环境变量示例
# 复制为 .env 后按需修改；也可直接由 install.sh --airport <name> 自动生成。

# ============ 机场（核心） ============
# 机场预设名（对应 airports/<name>.conf），留空则交互选择
AIRPORT_ID=default
# 订阅链接（clash/mihomo YAML、base64 或分享链接均可）
CLASH_SUBSCRIPTION_URL=
# 订阅 UA（默认 clash-verge/v2.4.0，兼容 hy2/anytls）
CLASH_SUBSCRIPTION_UA=clash-verge/v2.4.0

# ============ 代理内核 ============
KERNEL_TYPE=mihomo
# MIHOMO_VERSION=v1.19.23
# CLASH_VERSION=v1.18.0
# YQ_VERSION=v4.52.4
# SUBCONVERTER_VERSION=v0.9.9

# ============ 端口（clash ↔ mosdns 联动） ============
MIXED_PORT=7890                  # clash HTTP/SOCKS 混合端口
EXTERNAL_CONTROLLER=0.0.0.0:9090  # clash API/WebUI
CLASH_DNS_PORT=1053              # clash 内部 DNS（fakeip/redir-host）
MOSDNS_DNS_PORT=5335             # mosdns 监听端口
MOSDNS_WEBUI_PORT=9099           # mosdns WebUI

# ============ IPv6 / DNS ============
CLASH_IPV6=auto                   # auto / on / off
AIRPORT_DNS_MODE=fakeip           # fakeip / redir-host
AIRPORT_DOMESTIC_DNS=223.5.5.5;119.29.29.29
AIRPORT_PROXY_DNS=https://1.1.1.1/dns-query;tls://8.8.8.8:853

# ============ mosdns ============
MOSDNS_VERSION=latest             # latest 或具体 tag 如 v0.7.1
# MOSDNS_REPO=https://github.com/jasonxtt/mosdns

# ============ GitHub 加速 ============
CLASH_GH_PROXY=https://ghfast.top
# 其他可用镜像：https://gh-proxy.org、https://ghproxy.net、https://kkgithub.com

# ============ 离线 / 预下载 ============
CLASH_BUNDLED_ASSET_ENABLED=true
CLASH_PREDOWNLOAD_GEO=true
# CLASH_OFFLINE=false

# ============ 静态路由（与 ROS / 爱快 / Linux 主路由配合） ============
# ROUTE_TARGET=linux          # linux / ros / ikuai，留空则不自动写路由
# ROUTE_GATEWAY=192.168.1.1   # 主路由 LAN IP
# ROUTE_LAN_IF=eth0           # 本机网卡（linux 目标可自动探测）
# ROUTE_LAN_IP=192.168.1.2     # 本机 LAN IP
# ROUTE_LAN_CIDR=192.168.1.0/24
# ROUTE_SSH_HOST=192.168.1.1   # ROS SSH 主机（ros 目标用）
# ROUTE_SSH_PORT=22
# ROUTE_SSH_USER=admin
# ROUTE_IKUAI_HOST=192.168.1.1 # 爱快后台地址（ikuai 目标用）
# ROUTE_IKUAI_USER=admin
